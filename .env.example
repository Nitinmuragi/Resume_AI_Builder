# ==============================================================================
# RENDER BACKEND ENVIRONMENT VARIABLES (Set in Render Dashboard -> Environment)
# ==============================================================================
PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
FRONTEND_URL=https://your-resume-builder.netlify.app

# Optional Backend Variables
JWT_EXPIRES_IN=7d
MAX_RESUMES_PER_USER=12
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ==============================================================================
# NETLIFY FRONTEND ENVIRONMENT VARIABLES (Set in Netlify Dashboard -> Site configuration -> Environment variables)
# ==============================================================================
VITE_API_URL=https://your-resume-builder-api.onrender.com/api
